---
import Layout from "../layouts/Layout.astro";
import { readdir, mkdir } from "fs/promises";

const DATA_DIR = "./src/_data";
let files: string[] = [];

try {
  await mkdir(DATA_DIR, { recursive: true });
  files = await readdir(DATA_DIR);
} catch (e) {
  files = [];
}

// Estrae solo i nomi unici dei gruppi (es. siti-greenblu)
const groupsMap = new Map();

files.forEach((file) => {
  if (!file.endsWith(".json")) return;
  
  const baseGroup = file
    .replace("-desktop", "")
    .replace("-phone", "")
    .replace("-origin.json", "")
    .replace("-url.json", "")
    .replace(".json", "");

  if (!groupsMap.has(baseGroup)) {
    groupsMap.set(baseGroup, {
      title: baseGroup.replace("siti-", "Siti ").replaceAll("-", " "),
      slug: baseGroup,
    });
  }
});

const groups = Array.from(groupsMap.values());
---

<Layout title="CrUX Dashboard">
  <main class="dashboard-container">
    <header class="header">
      <h1>CrUX Dashboard</h1>
      <p class="subtitle">CHROME USER EXPERIENCE METRICS</p>
    </header>

    <div class="grid">
      {groups.map((group) => (
        <div class="card">
          <div class="card-body">
            <h2>{group.title}</h2>
            <p>Monitoraggio Core Web Vitals e metriche CrUX per il gruppo {group.title}.</p>
          </div>
          <a href={`/distribution/${group.slug}`} class="btn-open">
            Visualizza i dati →
          </a>
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .dashboard-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: system-ui, -apple-system, sans-serif;
  }
  .header {
    margin-bottom: 2.5rem;
    border-bottom: 1px solid #e5e7eb;
    padding-bottom: 1rem;
  }
  .header h1 {
    font-size: 2.25rem;
    font-weight: 800;
    color: #111827;
    margin: 0;
  }
  .subtitle {
    font-size: 0.75rem;
    color: #6b7280;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 1.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
  }
  .card-body h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #111827;
    margin: 0 0 0.5rem 0;
    text-transform: capitalize;
  }
  .card-body p {
    font-size: 0.875rem;
    color: #6b7280;
    margin: 0 0 1.5rem 0;
  }
  .btn-open {
    display: block;
    text-align: center;
    background-color: #2563eb;
    color: #ffffff;
    font-weight: 600;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .btn-open:hover {
    background-color: #1d4ed8;
  }
</style>
