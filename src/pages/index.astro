---
import Layout from "../layouts/Layout.astro";
import Card from "../components/Card.astro";
import { readdir } from "fs/promises";

const DATA_DIR = "./src/_data";
let files: string[] = [];

try {
  files = await readdir(DATA_DIR);
} catch (e) {
  files = [];
}

// Estrae i gruppi unici (es. siti-greenblu, siti-nicolaus, ecc.)
const groupsMap = new Map();

files.forEach((file) => {
  if (!file.endsWith(".json")) return;
  
  // Pulizia del nome file per identificare il gruppo base
  const baseGroup = file
    .replace("-desktop", "")
    .replace("-phone", "")
    .replace("-origin.json", "")
    .replace("-url.json", "")
    .replace(".json", "");

  if (!groupsMap.has(baseGroup)) {
    groupsMap.set(baseGroup, {
      title: baseGroup.replace("siti-", "Siti ").replaceAll("-", " "),
      slug: baseGroup,
    });
  }
});

const groups = Array.from(groupsMap.values());
---

<Layout title="CrUX Dashboard">
  <main class="container mx-auto p-6">
    <h1 class="text-3xl font-bold mb-8">CrUX Dashboard</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {groups.map((group) => (
        <div class="bg-white p-6 rounded-xl border border-gray-200 shadow-sm flex flex-col justify-between">
          <h2 class="text-xl font-bold capitalize mb-4 text-gray-800">
            {group.title}
          </h2>

          <div class="space-y-4">
            <!-- Sezione Mobile -->
            <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
              <div class="text-xs font-bold text-gray-500 uppercase mb-2 flex items-center gap-1">
                📱 Phone / Mobile
              </div>
              <div class="grid grid-cols-2 gap-2 text-xs font-semibold">
                <a href={`/distribution/${group.slug}-phone-origin`} class="p-2 bg-indigo-50 text-indigo-700 rounded hover:bg-indigo-100 text-center">
                  📊 Intero Sito
                </a>
                <a href={`/distribution/${group.slug}-phone-url`} class="p-2 bg-indigo-50 text-indigo-700 rounded hover:bg-indigo-100 text-center">
                  🏠 Home Page
                </a>
              </div>
            </div>

            <!-- Sezione Desktop -->
            <div class="bg-gray-50 p-3 rounded-lg border border-gray-100">
              <div class="text-xs font-bold text-gray-500 uppercase mb-2 flex items-center gap-1">
                💻 Desktop
              </div>
              <div class="grid grid-cols-2 gap-2 text-xs font-semibold">
                <a href={`/distribution/${group.slug}-desktop-origin`} class="p-2 bg-emerald-50 text-emerald-700 rounded hover:bg-emerald-100 text-center">
                  📊 Intero Sito
                </a>
                <a href={`/distribution/${group.slug}-desktop-url`} class="p-2 bg-emerald-50 text-emerald-700 rounded hover:bg-emerald-100 text-center">
                  🏠 Home Page
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
